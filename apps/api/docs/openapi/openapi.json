{
  "openapi": "3.1.0",
  "info": {
    "title": "FreelanceManager API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "auth",
      "description": "Authentication and session management."
    },
    {
      "name": "user",
      "description": "Current user account."
    },
    {
      "name": "clients",
      "description": "Client records."
    },
    {
      "name": "jobs",
      "description": "Client jobs."
    },
    {
      "name": "materials",
      "description": "Materials used on jobs."
    },
    {
      "name": "payments",
      "description": "Payments received for jobs."
    },
    {
      "name": "dashboard",
      "description": "Dashboard summary."
    }
  ],
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with existing data.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "minLength": 3
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          }
        },
        "required": [
          "id",
          "username",
          "login"
        ],
        "additionalProperties": false
      },
      "LoginUser": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "login",
          "password"
        ],
        "additionalProperties": false
      },
      "RegisterUser": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "username",
          "login",
          "password"
        ],
        "additionalProperties": false
      },
      "LogoutResponse": {
        "type": "string",
        "enum": [
          "OK"
        ]
      },
      "EditUser": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false
      },
      "ClientResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "contact": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "contact",
          "userId"
        ],
        "additionalProperties": false
      },
      "RegisterClient": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "contact"
        ],
        "additionalProperties": false
      },
      "EditClient": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "ClientListResponse": {
        "type": "object",
        "properties": {
          "totalPages": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "clients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientResponse"
            }
          }
        },
        "required": [
          "totalPages",
          "clients"
        ],
        "additionalProperties": false
      },
      "JobArrayResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/JobResponse"
        }
      },
      "JobResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobDate": {
            "type": "string",
            "pattern": "^\\d{2}\\/\\d{2}\\/\\d{4}$"
          },
          "descr": {
            "type": "string"
          },
          "payed": {
            "type": "string",
            "enum": [
              "Pagamento Realizado",
              "Aguardando Pagamento"
            ]
          },
          "totalValue": {
            "type": "string",
            "pattern": "^-?\\d{1,3}(?:\\.\\d{3})*,\\d{2}$"
          },
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "jobDate",
          "descr",
          "payed",
          "totalValue",
          "clientId",
          "userId"
        ],
        "additionalProperties": false
      },
      "RegisterJob": {
        "type": "object",
        "properties": {
          "jobDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "descr": {
            "type": "string",
            "minLength": 1
          },
          "payed": {
            "type": "boolean"
          },
          "totalValue": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          }
        },
        "required": [
          "jobDate",
          "descr",
          "payed",
          "totalValue"
        ],
        "additionalProperties": false
      },
      "JobListResponse": {
        "type": "object",
        "properties": {
          "totalPages": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          }
        },
        "required": [
          "totalPages",
          "jobs"
        ],
        "additionalProperties": false
      },
      "EditJob": {
        "type": "object",
        "properties": {
          "jobDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "descr": {
            "type": "string",
            "minLength": 1
          },
          "payed": {
            "type": "boolean"
          },
          "totalValue": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          }
        },
        "additionalProperties": false
      },
      "MaterialResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "descr": {
            "type": "string"
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "qnt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unitaryVal": {
            "type": "string",
            "pattern": "^-?\\d{1,3}(?:\\.\\d{3})*,\\d{2}$"
          },
          "totalVal": {
            "type": "string",
            "pattern": "^-?\\d{1,3}(?:\\.\\d{3})*,\\d{2}$"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "descr",
          "supplier",
          "qnt",
          "unitaryVal",
          "totalVal",
          "jobId"
        ],
        "additionalProperties": false
      },
      "RegisterMaterial": {
        "type": "object",
        "properties": {
          "descr": {
            "type": "string",
            "minLength": 1
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "qnt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unitaryVal": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          }
        },
        "required": [
          "descr",
          "qnt",
          "unitaryVal"
        ],
        "additionalProperties": false
      },
      "MaterialListResponse": {
        "type": "object",
        "properties": {
          "materials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MaterialResponse"
            }
          },
          "totalValue": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "materials",
          "totalValue"
        ],
        "additionalProperties": false
      },
      "EditMaterial": {
        "type": "object",
        "properties": {
          "descr": {
            "type": "string",
            "minLength": 1
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "qnt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unitaryVal": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          }
        },
        "additionalProperties": false
      },
      "PaymentListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentResponse"
            }
          },
          "totalValue": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "data",
          "totalValue"
        ],
        "additionalProperties": false
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "method": {
            "type": "string"
          },
          "paymentDate": {
            "type": "string",
            "pattern": "^\\d{2}\\/\\d{2}\\/\\d{4}$"
          },
          "value": {
            "type": "string",
            "pattern": "^-?\\d{1,3}(?:\\.\\d{3})*,\\d{2}$"
          },
          "installment": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "method",
          "paymentDate",
          "value",
          "installment",
          "jobId"
        ],
        "additionalProperties": false
      },
      "RegisterPayment": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "paymentDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "value": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          },
          "installment": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "method",
          "paymentDate",
          "value",
          "installment"
        ],
        "additionalProperties": false
      },
      "EditPayment": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "paymentDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "value": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99
          },
          "installment": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      },
      "DashboardResponse": {
        "type": "object",
        "properties": {
          "clients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientResponse"
            }
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            }
          },
          "profit": {
            "type": "string",
            "pattern": "^-?\\d{1,3}(?:\\.\\d{3})*,\\d{2}$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "clients",
          "jobs",
          "profit",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "login": "ada@example.com",
                "password": "secure-pass"
              },
              "schema": {
                "$ref": "#/components/schemas/LoginUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "username": "Ada Lovelace",
                  "login": "ada@example.com"
                },
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register an account",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "username": "Ada Lovelace",
                "login": "ada@example.com",
                "password": "secure-pass"
              },
              "schema": {
                "$ref": "#/components/schemas/RegisterUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "username": "Ada Lovelace",
                  "login": "ada@example.com"
                },
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log out",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "text/html": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Get the current user",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "username": "Ada Lovelace",
                  "login": "ada@example.com"
                },
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/edit-user": {
      "patch": {
        "tags": [
          "user"
        ],
        "summary": "Edit the current user",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "username": "Ada L."
              },
              "schema": {
                "$ref": "#/components/schemas/EditUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/clients": {
      "post": {
        "tags": [
          "clients"
        ],
        "summary": "Create a client",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Acme",
                "address": "123 Main Street",
                "contact": "555-0100"
              },
              "schema": {
                "$ref": "#/components/schemas/RegisterClient"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "example": {
                  "id": "22222222-2222-4222-8222-222222222222",
                  "name": "Acme",
                  "address": "123 Main Street",
                  "contact": "555-0100",
                  "userId": "11111111-1111-4111-8111-111111111111"
                },
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "List clients",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "search",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/clients/{id}": {
      "get": {
        "tags": [
          "clients"
        ],
        "summary": "Get a client",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "clients"
        ],
        "summary": "Edit a client",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Acme Updated"
              },
              "schema": {
                "$ref": "#/components/schemas/EditClient"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "clients"
        ],
        "summary": "Delete a client",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Successful response."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/clients/{id}/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List jobs for a client",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
