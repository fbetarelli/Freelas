{
  "name": "@freelancemanager/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.ts",
    "start": "node server.ts",
    "migrate": "node-pg-migrate up",
    "typecheck": "tsc --noEmit",
    "docs:build": "node docs/openapi/scripts/build.ts && redocly build-docs docs/openapi/openapi.json --output docs/openapi/reference.tmp.html --inlineBundle --openapi.hideDownloadButtons && node docs/openapi/scripts/finalize.ts",
    "docs:check": "node docs/openapi/scripts/build.ts --check",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dates": "set TZ=UTC&& npm run test -- --run src/entities/job/tests/job.spec.ts src/entities/payment/tests/payment.spec.ts && set TZ=America/Sao_Paulo&& npm run test -- --run src/entities/job/tests/job.spec.ts src/entities/payment/tests/payment.spec.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@freelancemanager/shared": "*",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^8.0.4",
    "path": "^0.12.7",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.72.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.10.0",
    "morgan": "^1.10.1",
    "tsx": "^4.23.13",
    "typescript": ">=5.0.0 <6.1.0",
    "typescript-eslint": "^8.70.0"
  }
}
