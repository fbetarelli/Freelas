</html>
<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>Freelas: <%=job.descr%>

    </title>

</head>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
    href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Momo+Signature&family=Trispace:wght@100..800&display=swap"
    rel="stylesheet" />
<link rel="stylesheet" href="/styles/output.css" />
<script src="/js/jobPage.js" defer></script>
<script src="/js/mobileNav.js" defer></script>

<body>
    <div class="flex min-h-screen relative flex-col">
        <div
            class="inset-0 min-h-screen w-full bg-main-background bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] text-main-text/85">
            <header id="header"
                class="w-full z-10 mb-3  transition-all  
                duration-250 ease-in-out items-center w-full sticky top-0 translate-y-0  flex justify-between bg-linear-to-t from-card-background to-footer text-shadow-lg/30 text-main-accent rounded-b-4xl text-4xl md:text-2xl md:py-3 p-5 font-momo">
                <a href="/">Freelas</a>
                <nav class=" max-sm:hidden flex text-xs gap-2 font-trispace text-nowrap text-main-text/80">
                    <a href="/dashboard" class="
                         px-4   w-full  inline-flex items-center hover:underline cursor-pointer    ">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-4 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                        Dashboard
                    </a>
                    |
                    <a href="/clients" class="
                         px-4  w-full inline-flex items-center hover:underline cursor-pointer  ">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-4 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                        </svg>
                        Lista de Clientes</a>
                    |
                    <a href="/jobs" class="
                        px-4  w-full inline-flex  items-center hover:underline cursor-pointer  ">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-4 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                        </svg>

                        Lista de Serviços</a>



                </nav>
                <span class="invisible max-sm:hidden px-4 text-xs font-trispace inline-flex items-center hover:underline cursor-pointer
                text-red-400">
                    <p class="font-medium ">Sair</p>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                        stroke="currentColor" class="size-4 self-center">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                    </svg>

                </span>


                <button class="md:hidden mr-2
                " id="hamburgerMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="size-8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </header>

            <div id="menubackground"
                class="z-10 hidden  bg-[rgba(17,24,39,0.9)] left-0 top-0 w-full min-h-screen inset-0">
            </div>
            <div id="menu"
                class="fixed z-20 text-xl font-lato transition-all  
                duration-250  ease-in-out w-[70%] left-full top-0  min-h-screen bg-linear-to-t from-card-background from-60% to-footer">
                <div class="my-4">
                    <p class="text-4xl text-main-accent p-6  font-trispace">
                        Menu</p>

                    <div class="flex flex-col gap-8   text-lg">
                        <div class="w-full p-[1px]   bg-linear-to-r from-transparent via-[#243e5c] to-transparent">
                        </div>
                        <a href="/dashboard" class="
                         px-4  w-full inline-flex items-center     ">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                            Dashboard
                        </a>

                        <a href="/clients" class="
                         px-4  w-full inline-flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                            </svg>
                            Lista de Clientes</a>

                        <a href="/jobs" class="
                        px-4  w-full inline-flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                            </svg>

                            Lista de Serviços</a>
                        <div class="w-full p-[1px]   bg-linear-to-r from-transparent via-[#243e5c] to-transparent">
                        </div>
                        <a href="/profile" class="
                        px-4  w-full inline-flex items-center text-main-accent hover:opacity-75">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                            </svg>


                            Perfil</a>
                        <a href="/logout" class="
                        px-4  w-full inline-flex items-center text-red-400 hover:opacity-75">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                            </svg>

                            Sair</a>

                    </div>

                </div>
            </div>
            <div class="md:flex md:gap-4 md:px-2 ">
                <div class="flex flex-col gap-2 px-4 pt-4 md:pt-0 pb-6">
                    <div class="pb-3 md:pb-0">
                        <p class="font-trispace text-3xl font-medium text-job-accent">Página do Serviço</p>
                        <ul class="flex gap-1 truncate p-1 text-sm text-gray-500">
                            <li><a href="/dashboard" class="hover:underline">Dashboard</a> -></li>

                            <li><a href="/clients" class="hover:underline">Clientes</a> -></li>

                            <li><a href="/client/<%=job.clientId%>" class="hover:underline">Cliente</a> -></li>
                            <li>
                                <%=job.descr%>
                            </li>
                        </ul>
                    </div>

                    <div
                        class="w-full rounded-2xl border-5 border-card-background bg-linear-to-br from-card-background to-transparent px-4 py-4 md:pt-3 font-lato text-lg md:text-base shadow-sm">
                        <p class="text-center font-trispace text-2xl font-bold">
                            <%=job.descr%>
                        </p>
                        <div class="my-3 w-full bg-linear-to-r from-transparent via-[#243e5c] to-transparent p-[1px]">
                        </div>
                        <p class="wrap-anywhere">
                            Serviço Realizado em
                            <span class="text-job-accent">
                                <%=job.jobDate%>
                            </span>
                        </p>
                        <p>
                            Valor Total:
                            <span class="text-job-accent">R$<%=job.totalValue%></span>
                        </p>
                        <p>
                            Status:
                            <span class="text-main-accent">
                                <%=job.payed%>
                            </span>
                        </p>
                    </div>
                    <div
                        class="w-full rounded-2xl border-5 border-card-background md:text-base  bg-linear-to-br from-card-background to-transparent px-4 py-4 font-lato text-lg shadow-sm">
                        <% if (payments.length>0) { %>
                            <p>
                                Total Dos Pagamentos:
                                <span class="text-payment-accent">+R$<%=paymentsVal%></span>
                            </p>
                            <% }%>
                                <% if (materials.length>0) { %>
                                    <p>
                                        Total Dos Materiais:
                                        <span class="text-material-accent">-R$<%=materialsVal%></span>
                                    </p>
                                    <% }%>
                                        <p>
                                            Lucro Total:
                                            <span class="text-main-accent"> R$<%=profit%></span>
                                        </p>
                    </div>

                    <button id="editJobBtn"
                        class="inline-flex w-full cursor-pointer items-center rounded-2xl bg-job-accent p-4  font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="mr-2 size-8 md:size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg>

                        <p>Editar Serviço</p>
                    </button>

                    <div class="flex flex-row gap-2">
                        <button id="newMaterialBtn"
                            class="mx-auto inline-flex w-1/2 cursor-pointer items-center rounded-2xl bg-material-accent p-2 font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="mr-2 size-8 md:size-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
                            </svg>

                            <p>Novo Material</p>
                        </button>
                        <button id="newPaymentBtn"
                            class="mx-auto inline-flex w-1/2 cursor-pointer items-center rounded-2xl bg-payment-accent p-2 font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="mr-2 size-10 md:size-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
                            </svg>

                            Novo Pagamento
                        </button>
                    </div>
                </div>

                <div class="md:flex md:flex-col md:max-w-[63%] md:min-w-0 ">
                    <% if(materials.length>0 ) { %>
                        <div id="materialsList" class="flex flex-col gap-2">
                            <p class="px-6 pb-2 font-trispace text-xl text-material-accent">Materiais</p>

                            <div class="scrollbar flex flex-row overflow-x-auto px-4 pb-4 font-lato font-bold">
                                <% materials.forEach(material=> { %>
                                    <div
                                        class="mx-2 flex w-full max-w-3xs md:text-sm  md:basis-46  md:min-w-0  shrink-0 flex-col justify-center gap-1 rounded-2xl bg-linear-to-b from-card-background to-card-background/50 p-4 text-lg shadow-sm">
                                        <p class="truncate">
                                            <%=material.descr%> <span class="text-material-accent">x<%=material.qnt%>
                                                </span>
                                        </p>
                                        <p class="truncate text-base md:text-sm text-gray-400">Valor Uni.
                                            <%=material.unitaryVal%>
                                        </p>
                                        <p class="truncate text-base md:text-sm text-gray-400">Fornecedor:
                                            <%=material.supplier%>
                                        </p>
                                        <p>Preço Total: <span class="text-material-accent">R$<%=material.totalVal%>
                                            </span>
                                        </p>

                                        <button data-id="<%=material.id%>"
                                            class="editMaterialButton my-1 rounded-2xl border-3 md:text-base md:border-2 border-material-accent px-4 py-2 text-lg text-material-accent transition-all hover:bg-material-accent hover:text-gray-900">Editar
                                            Material</button>
                                    </div>
                                    <dialog data-id="<%=material.id%>"
                                        class="editMaterialDialog flex-col text-main-text/85 font-normal">
                                        <form method="POST" action="/job/<%=job.id%>/material/<%=material.id%>/edit"
                                            class="actionForm m-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg md:text-sm shadow-sm">
                                            <div class="inline-flex items-center justify-between">
                                                <p class="font-trispace text-2xl md:text-xl text-main-accent">Editar
                                                    Material</p>
                                                <button data-id="<%=material.id%>" class="closeEditMaterial"
                                                    type="button">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                        viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                                        class="ml-4 size-6 opacity-80 hover:opacity-100">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            d="M6 18 18 6M6 6l12 12" />
                                                    </svg>
                                                </button>
                                            </div>
                                            <p>Descrição</p>
                                            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="descr"
                                                placeholder="Material Utilizado" value="<%=material.descr%>" />
                                            <p>Fornecedor</p>
                                            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="supplier"
                                                placeholder="Loja/Fornecedor do Material"
                                                value="<%=material.supplier%>" />
                                            <p>Quantidade</p>
                                            <input type="text" class="valueInput mx-2 rounded-2xl bg-input-box p-3"
                                                name="qnt" placeholder="Ex: 1" value="<%=material.qnt%>" />
                                            <p>Valor Unitário</p>
                                            <input type="text" inputmode="decimal"
                                                class="valueInput mx-2 rounded-2xl bg-input-box p-3" name="unitaryVal"
                                                placeholder="Ex: 12,34" value="<%=material.unitaryVal%>" />

                                            <button
                                                class="submitForm my-2 md:my-0 w-full md:text-base cursor-pointer rounded-2xl bg-material-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                                                type="submit">Salvar Alterações</button>
                                            <p class="actionError text-red-400"></p>
                                            <a href="/job/<%=job.id%>/material/<%=material.id%>/delete"
                                                class="-mt-1 rounded-2xl border-3 border-payment-accent md:text-base font-bold text-center px-4 py-2 text-lg text-payment-accent transition-all hover:bg-payment-accent hover:text-gray-900">
                                                Apagar Material</a>
                                        </form>
                                    </dialog>
                                    <% })%>
                            </div>

                        </div>
                        <%}%>

                            <% if(payments.length>0 ) { %>
                                <div id="paymentsList" class="flex flex-col gap-2 mb-2">
                                    <p class="px-6 py-2 font-trispace text-xl text-payment-accent">Pagamentos</p>

                                    <div class="scrollbar flex flex-row overflow-x-auto  px-4 pb-4 font-lato font-bold">
                                        <% payments.forEach(payment=> { %>
                                            <div
                                                class="mx-2 flex w-full max-w-3xs  md:text-sm  md:basis-46  md:min-w-0  shrink-0 flex-col justify-center gap-1 rounded-2xl bg-linear-to-b from-card-background to-card-background/50 p-4 text-lg shadow-sm">
                                                <p>Valor do Pagamento: </br><span class="text-payment-accent">R$
                                                        <%=payment.value%>
                                                    </span>
                                                    <span class="text-gray-400 text-base md:text-sm">
                                                        (<%=payment.paymentDate%>)
                                                    </span>
                                                </p>

                                                <p class="truncate text-base md:text-sm text-gray-400">Método:
                                                    <% if (payment.method) {%>
                                                        <%=payment.method%>
                                                            <% } else { %>
                                                                Indefinido
                                                                <%}%>
                                                </p>

                                                <p>Parcela: <span class="text-payment-accent">
                                                        <%=payment.installment%>x
                                                    </span></p>

                                                <button data-id="<%=payment.id%>"
                                                    class="editPaymentButton md:text-base md:border-2 md:p-2 my-1 rounded-2xl border-3 border-payment-accent px-4 py-2 text-lg text-payment-accent transition-all hover:bg-payment-accent hover:text-gray-900">Editar
                                                    Pagamento</button>
                                            </div>
                                            <dialog data-id="<%=payment.id%>"
                                                class="editPaymentDialog flex-col text-main-text/85 font-normal">
                                                <form method="POST"
                                                    action="/job/<%=job.id%>/payment/<%=payment.id%>/edit"
                                                    class="actionForm m-4 flex flex-col gap-2 rounded-2xl md:text-sm bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
                                                    <div class="inline-flex items-center justify-between">
                                                        <p class="font-trispace text-2xl md:text-lg text-main-accent">
                                                            Editar
                                                            Pagamento
                                                        </p>
                                                        <button data-id="<%=payment.id%>" class="closeEditPayment"
                                                            type="button">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                                viewBox="0 0 24 24" stroke-width="2"
                                                                stroke="currentColor"
                                                                class="ml-4 size-6 opacity-80 hover:opacity-100">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    d="M6 18 18 6M6 6l12 12" />
                                                            </svg>
                                                        </button>
                                                    </div>

                                                    <p>Valor</p>
                                                    <input type="text"
                                                        class="valueInput mx-2 rounded-2xl bg-input-box p-3"
                                                        name="value" placeholder="Valor do Pagamento"
                                                        value="<%=payment.value%>" />
                                                    <p>Método de Pagamento</p>
                                                    <input type="text" class="mx-2 rounded-2xl bg-input-box p-3"
                                                        name="method" placeholder="Ex: Pix"
                                                        value="<%=payment.method%>" />
                                                    <p>Número da Parcela</p>
                                                    <input type="text" class="mx-2 rounded-2xl bg-input-box p-3"
                                                        name="installment" placeholder="Ex: 1"
                                                        value="<%=payment.installment%>" />
                                                    <p>Data do Pagamento</p>
                                                    <input type="date" class="mx-2 rounded-2xl bg-input-box p-3"
                                                        name="paymentDate" />

                                                    <button
                                                        class="submitForm my-2 md:my-0 w-full cursor-pointer md:text-base rounded-2xl bg-payment-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                                                        type="submit">Salvar Alterações</button>
                                                    <p class="actionError text-red-400"></p>
                                                    <a href="/job/<%=job.id%>/payment/<%=payment.id%>/delete"
                                                        class="-mt-1 rounded-2xl border-3 border-payment-accent md:text-base font-bold text-center px-4 py-2 text-lg text-payment-accent transition-all hover:bg-payment-accent hover:text-gray-900">
                                                        Apagar Pagamento</a>
                                                </form>
                                            </dialog>
                                            <%})%>
                                    </div>
                                </div>
                                <%}%>
                </div>

            </div>
        </div>
        <footer class="flex w-full  flex-col gap-6 bg-footer p-6 font-lato text-sm text-[#bdc8c0]/80">
            <p>Freelas é um serviço independente criado para fins educativos e praticidade de usuários, para saber mais
                sobre
                o projeto acesse nossa <a class="text-main-accent underline underline-offset-2 hover:opacity-85"
                    href="https://github.com/fbetarelli/FreelanceManager">página no Github.</a></p>
            <p>Freelas™ 2026 Todos os Direitos Resevados.</p>
        </footer>
    </div>

    <dialog id="jobDialog" class="flex-col text-main-text/85">
        <form method="POST" action="/job/<%=job.id%>/edit"
            class="actionForm m-4 md:w-1/4 flex flex-col gap-2 rounded-2xl bg-card-background md:text-sm px-7 py-4 font-lato text-lg shadow-sm">
            <div class="inline-flex items-center justify-between">
                <p class="font-trispace text-2xl md:text-lg text-main-accent">Editar Serviço</p>
                <button id="closeJob" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="ml-4 size-6 opacity-80 hover:opacity-100">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <p>Descrição</p>
            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="descr"
                 value="<%=job.descr%>" />
            <p>Data</p>
            <input type="date" class="mx-2 rounded-2xl bg-input-box p-3" name="date" />
            <p>Valor Total</p>
            <input type="text" class="valueInput mx-2 rounded-2xl bg-input-box p-3" name="totalValue"
                value="<%=job.totalValue%>" placeholder="123,45" />
            <p>Serviço foi pago?</p>
            <div class="relative w-full px-1">
                <select name="payed" class="w-full appearance-none rounded-2xl bg-input-box p-3">
                    <option value="">Não alterar</option>
                    <option value="true">Pago</option>
                    <option value="false">Não pago</option>
                </select>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3"
                    stroke="currentColor"
                    class="pointer-events-none absolute top-1/2 right-[15px] size-6 translate-y-[-50%]">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
                </svg>
            </div>

            <button
                class="submitForm my-2 md:my-0 w-full cursor-pointer md:text-base rounded-2xl bg-job-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                type="submit">Salvar Alterações</button>
            <p class="actionError text-red-400"></p>
            <button type="button" id="deleteJobBtn"
                class="-mt-1 rounded-2xl border-3 md:text-base border-payment-accent font-bold text-center px-4 py-2 text-lg text-payment-accent transition-all hover:bg-payment-accent hover:text-gray-900">Apagar
                Serviço</button>
        </form>
    </dialog>
    <dialog id="deleteJobDialog" class="flex-col text-main-text/85">
        <div
            class="m-4 flex flex-col gap-2 rounded-2xl md:text-sm bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
            <div class="inline-flex items-center justify-between">
                <p class="font-trispace text- md:text-lg text-red-400">Apagar Serviço?</p>
                <button id="closeDeleteJob" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="ml-4 size-6 opacity-80 hover:opacity-100">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="mx-auto pt-6 pb-8 text-center">
                <p>Você tem certeza disso?</p>
                <p>Esta ação é <b class="text-red-400">Irreversível!</b></p>
            </div>
            <a href="/job/<%=job.id%>/delete"
                class="-mt-1 rounded-2xl bg-payment-accent md:text-base font-bold text-center px-4 py-2 text-lg text-gray-900 transition-all hover:bg-payment-accent hover:text-gray-900">
                Estou ciente disso.</a>
        </div>

    </dialog>
    <dialog id="addMaterialDialog" class="flex-col text-main-text/85">
        <form method="POST" action="/job/<%=job.id%>/material/add"
            class="actionForm m-4 flex flex-col gap-2 rounded-2xl md:text-sm bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
            <div class="inline-flex items-center justify-between">
                <p class="font-trispace text-2xl md:text-lg text-main-accent">Adicionar Material</p>
                <button id="closeAddMaterial" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="ml-4 size-6 opacity-80 hover:opacity-100">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <p class="text-material-accent">Campos obrigatórios*</p>
            <p>Descrição<span class="text-material-accent">*</span></p>
            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="descr" placeholder="Material Utilizado"
                required />
            <p>Fornecedor</p>
            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="supplier"
                placeholder="Loja/Fornecedor do Material" />
            <p>Quantidade<span class="text-material-accent">*</span></p>
            <input type="text" class="valueInput  mx-2 rounded-2xl bg-input-box p-3" name="qnt" placeholder="Ex: 1"
                required />
            <p>Valor Unitário<span class="text-material-accent">*</span></p>
            <input id="addUnitaryVal" type="text" inputmode="decimal"
                class="valueInput mx-2 rounded-2xl bg-input-box p-3" name="unitaryVal" placeholder="Ex: 12,34"
                required />

            <button id="submitAddMaterial"
                class="submitForm my-2 w-full md:text-base cursor-pointer rounded-2xl bg-material-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                type="submit">Adicionar Material</button>
            <p class="actionError text-red-400"></p>
        </form>
    </dialog>
    <dialog id="addPaymentDialog" class="flex-col text-main-text/85">
        <form method="POST" action="/job/<%=job.id%>/payment/add"
            class="actionForm m-4 flex flex-col gap-2 rounded-2xl  md:text-sm bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
            <div class="inline-flex items-center justify-between">
                <p class="font-trispace text-2xl md:text-lg text-main-accent">Adicionar Pagamento</p>
                <button id="closeAddPayment" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="ml-4 size-6 opacity-80 hover:opacity-100">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <p class="text-payment-accent">Campos obrigatórios*</p>
            <p>Valor <span class="text-payment-accent">*</span></p>
            <input type="text" id="paymentValue" class="valueInput mx-2 rounded-2xl bg-input-box p-3" name="value"
                placeholder="Valor do Pagamento" required />
            <p>Método de Pagamento</p>
            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="method" placeholder="Ex: Pix" />
            <p>Número da Parcela<span class="text-payment-accent">*</span></p>
            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="installment" placeholder="Ex: 1"
                required />
            <p>Data do Pagamento<span class="text-payment-accent">*</span></p>
            <input type="date" class="mx-2 rounded-2xl bg-input-box p-3" name="paymentDate" required />

            <button id="submitAddPayment"
                class="submitForm my-2 w-full md:text-base cursor-pointer rounded-2xl bg-payment-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                type="submit">Adicionar Pagamento</button>
            <p class="actionError text-red-400"></p>
        </form>
    </dialog>
</body>

</html>