<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h3>Registrar</h3>
    <form method="POST" action="/register">
        Nome de Usuário: <input type="text" name="username" placeholder="insira o seu nome ou de sua empresa "
            required /> </br>
        Login: <input type="email" name="email" placeholder="insira seu email aqui" required /> </br>
        Senha: <input type="password" name="password" placeholder="insira sua senha aqui" required /> </br>
        <button type="submit">
            Enviar
        </button>
    </form> </br>
    <a href="/login">Fazer Login</a>
</body>

</html>