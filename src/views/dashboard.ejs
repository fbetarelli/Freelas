<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="/js/dashboard.js" defer></script>
</head>

<body>
    <h1>dashboards</h1> </br>
    <a href="/logout">Sair</a>

    <% for(let i=0; i < clients.length; i++) { %>
        <div class="">
            <h3>
                <%= clients[i].getName() %>
            </h3>
            <p>
                <%= clients[i].getContact() %>
            </p>
            <p>
                <%= clients[i].getAddress() %>
            </p>
            <a href="/client/<%=clients[i].getId()%>">Ver informações e serviços</a> </br>
        </div>
        <% } %>


            <h3>Adicionar Cliente</h3> </br>
            <form method="POST" action="/addClient">
                *Obrigatório </br>
                * Nome: </br>
                <input type="text" name="name" placeholder="insira o nome do cliente" required /> </br>
                Endereço (opcional): </br>
                <input type="text" name="address" placeholder="insira o endereço do cliente" /> </br>
                * Contato: </br>
                <input type="text" name="contact" placeholder="insira o contato do cliente" required /> </br>
                <button type="submit">
                    Enviar
                </button>
            </form>
</body>

</html>