<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Freelas</title>
    <link rel="icon" type="image/png" href="/images/favicon.png" />
</head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Momo+Signature&family=Trispace:wght@100..800&display=swap"
    rel="stylesheet">
<link rel="stylesheet" href="/styles/output.css" />
<script src="/js/dashboard.js" defer></script>
<script src="/js/mobileNav.js" defer></script>

<body>
    <div class="flex min-h-screen relative flex-col">
        <div
            class="inset-0 min-h-screen w-full bg-main-background bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] text-main-text/85">
            <header id="header"
                class="w-full z-10 mb-3  transition-all  
                duration-250 ease-in-out items-center w-full sticky top-0 translate-y-0  flex justify-between bg-linear-to-t from-card-background to-footer text-shadow-lg/30 text-main-accent rounded-b-4xl text-4xl md:text-2xl md:py-3 p-5 font-momo">
                <a href="/">Freelas</a>
                <nav class=" max-sm:hidden flex text-xs gap-2 font-trispace text-nowrap text-main-text/80">
                    <p class="
                         px-4   w-full  inline-flex items-center hover:underline cursor-pointer    ">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-4 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                        Dashboard
                    </p>
                    |
                    <a href="/clients" class="
                         px-4  w-full inline-flex items-center hover:underline cursor-pointer  ">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-4 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                        </svg>
                        Lista de Clientes</a>
                    |
                    <a href="/jobs" class="
                        px-4  w-full inline-flex  items-center hover:underline cursor-pointer  ">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-4 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                        </svg>

                        Lista de Serviços</a>



                </nav>
                <a href="/logout"
                    class=" max-sm:hidden px-4 text-xs font-trispace  inline-flex items-center hover:underline cursor-pointer text-red-400">
                    <p class="font-medium ">Sair</p>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                        stroke="currentColor" class="size-4 self-center">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                    </svg>

                </a>

                <button class="md:hidden mr-2
                " id="hamburgerMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="size-8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </header>

            <div id="menubackground"
                class="z-10 hidden  bg-[rgba(17,24,39,0.9)] left-0 top-0 w-full min-h-screen inset-0">
            </div>
            <div id="menu"
                class="fixed z-20 text-xl font-lato transition-all  
                duration-500  ease-in-out w-[70%] left-full top-0  min-h-screen bg-linear-to-t from-card-background from-60% to-footer">
                <div class="my-4">
                    <p class="text-4xl text-main-accent p-6  font-trispace">
                        Menu</p>

                    <div class="flex flex-col gap-8   text-lg">
                        <div class="w-full p-[1px]   bg-linear-to-r from-transparent via-[#243e5c] to-transparent">
                        </div>
                        <p class="
                         px-4  w-full inline-flex items-center     ">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                            Dashboard
                        </p>

                        <a href="/clients" class="
                         px-4  w-full inline-flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                            </svg>
                            Lista de Clientes</a>

                        <a href="/jobs" class="
                        px-4  w-full inline-flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                            </svg>

                            Lista de Serviços</a>
                        <div class="w-full p-[1px]   bg-linear-to-r from-transparent via-[#243e5c] to-transparent">
                        </div>
                        <a href="/profile" class="
                        px-4  w-full inline-flex items-center text-main-accent hover:opacity-75">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                            </svg>


                            Perfil</a>
                        <a href="/logout" class="
                        px-4  w-full inline-flex items-center text-red-400 hover:opacity-75">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                            </svg>

                            Sair</a>

                    </div>

                </div>
            </div>
            <div id="dados" class="md:flex md:flex-row md:gap-8 md:px-6  ">

                <div class="flex md:basis-2/5 flex-col gap-2 px-4 pt-4 md:pt-0 pb-6  ">
                    <div class=" flex flex-col ">
                        <p class="font-trispace text-3xl md:text-2xl">Olá <%=username%>!</p>
                        <a href="/profile"
                            class=" py-1 md:text-xs text-lg font-trispace inline-flex items-center hover:underline cursor-pointer text-main-accent">
                            <p class="font-medium mr-2 ">Editar Conta</p>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-4 self-center">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                            </svg>

                        </a>
                    </div>


                    <dialog id="clientDialog" class="  text-main-text/85  flex-col ">
                        <form method="POST" action="/addClient"
                            class="m-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg md:text-sm shadow-sm">
                            <div class="inline-flex items-center justify-between">
                                <p class="font-trispace text-2xl text-main-accent">Adicionar Cliente</p>
                                <button id="closeClient" type="button">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor"
                                        class="ml-4 size-6 hover:opacity-100 opacity-80">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                            <p class="text-client-accent">Campos obrigatórios*</p>
                            <p>Nome<i class="text-client-accent">*</i></p>
                            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="name" maxlength="50"
                                placeholder="Ex: Exemplo da Silva" required />
                            <p>Endereço</p>
                            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="address" maxlength="60"
                                placeholder="Ex: Bairro Exemplo, Rua Exemplo, 123" />
                            <p>Contato <i class="text-client-accent">*</i></p>
                            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="contact" maxlength="30"
                                placeholder="Ex: (12) 12345-1234" required />

                            <button
                                class="my-2 w-full md:text-base  cursor-pointer rounded-2xl bg-client-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                                type="submit">Criar Novo Cliente</button>
                        </form>
                    </dialog>



                    <div
                        class="w-full rounded-2xl border-5 border-card-background bg-linear-to-tl from-card-background to-transparent px-3 py-4 text-center font-lato md:text-lg text-xl font-bold shadow-sm">
                        <p>Balanço:</p>
                        <p class="text-4xl md:text-2xl text-main-accent">R$<%=profit%>
                        </p>
                        <p class="text-base text-[#bdc8c0] md:text-sm">(último mês)</p>
                    </div>
                    <div
                        class="w-full rounded-2xl border-5 md:text-lg border-card-background bg-linear-to-br from-card-background to-transparent px-3 py-4 text-center font-lato text-xl font-bold shadow-sm">
                        <p>Serviços:</p>
                        <p class="text-4xl md:text-2xl text-main-accent">
                            <%=count%>
                        </p>
                        <p class="text-base md:text-sm text-[#bdc8c0]">(último mês)</p>
                    </div>
                    <div class="flex flex-row gap-2">
                        <button id="ClientBtn"
                            class=" inline-flex w-full justify-center text-center cursor-pointer items-center rounded-2xl bg-client-accent p-6 md:p-4 font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">


                            <p class="text-xl md:text-base relative flex">Adicionar Cliente
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke-width="1.5" stroke="currentColor"
                                    class=" absolute right-full top-1/2 translate-y-[-50%] mr-4 md:mr-2 md:size-6 size-8">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                                </svg>
                            </p>
                        </button>

                    </div>
                </div>

                <div class=" md:flex md:flex-col md:basis-4/5  md:min-w-0 ">

                    <div class="flex flex-col gap-2">
                        <% if(jobs.length>0 ) { %>

                            <p class="px-6 font-trispace pb-2 text-xl text-job-accent">Últimos Serviços</p>

                            <div
                                class="scrollbar self-center flex flex-row overflow-x-auto md:max-w-[90%]  px-4 md:px-0  pb-4 font-lato font-bold">
                                <% jobs.forEach(job=> { %>
                                    <div id="detalhesJob"
                                        class="mx-2 flex w-full max-w-3xs md:basis-46  md:min-w-0   shrink-0 flex-col justify-center gap-1 rounded-2xl bg-linear-to-b from-card-background to-card-background/50 p-4 shadow-sm">
                                        <p class="truncate font-lato md:text-base text-lg font-bold">
                                            <%=job.descr%> <span class="text-gray-400 text-base md:text-xs">
                                                    (<%=job.jobDate%>)
                                                </span>
                                        </p>
                                        <p class="text-base md:text-sm text-[#bdc8c0]">R$<%=job.totalValue%>
                                        </p>
                                        <p class="text-sm md:text-xs text-gray-400">
                                            <%=job.payed%>
                                        </p>
                                        <a href="/job/<%=job.id%>"
                                            class="my-1 rounded-2xl border-3 md:border-2 border-job-accent hover:bg-job-accent hover:text-gray-900 transition-all px-4 py-2  md:text-sm  text-lg text-job-accent">Ver
                                            Serviço</a>
                                    </div>
                                    <% }) %>
                                        <% if (jobs.length>=5) { %>
                                            <a href="/jobs"
                                                class="mx-2 flex gap-3 w-full max-w-3xs md:basis-30 text-lg md:shrink-0 text-nowrap transition-all hover:opacity-80 items-center flex flex-col  md:min-w-0    flex-col justify-center gap-1 rounded-2xl bg-job-accent  text-gray-900 p-4 px-6 shadow-sm">

                                                <p class="font-lato  text-center font-bold">
                                                    Lista de </br> Serviços </p>

                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                    stroke-width="1.5" stroke="currentColor" class="size-8">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                                </svg>

                                            </a>
                                            <% } %>
                            </div>
                            <% }; %>


                    </div>


                    <div id="clientList" class=" flex w-full   flex-col gap-4 px-6 py-4 pb-8 ">
                        <p class="font-trispace text-xl text-client-accent">Clientes</p>

                        <% clients.forEach(client=> { %>
                            <div
                                class="flex w-full flex-col rounded-2xl border-5 border-card-background bg-linear-to-tl from-card-background to-transparent p-4 text-base shadow-sm">
                                <p class="text truncate font-lato font-bold">
                                    <%= client.name %>
                                </p>
                                <p class="text-base text-client-accent">
                                    <%= client.contact%>
                                </p>

                                <button data-id="<%=client.id%>"
                                    class="openJobDialog inline-flex items-center  my-2 rounded-2xl border-3 md:border-2 border-job-accent hover:bg-job-accent transition-all hover:text-gray-900 px-4 py-2 font-lato font-bold text-job-accent">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="mr-2 size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
                                    </svg>

                                    Novo Serviço
                                </button>

                                <a href="/client/<%=client.id%>"
                                    class="h-sm my-2 rounded-2xl inline-flex items-center border-3 md:border-2 border-client-accent hover:bg-client-accent transition-all hover:text-gray-900 px-4 py-2 font-lato font-bold text-client-accent">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-6 mr-2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="m15.75 15.75-2.489-2.489m0 0a3.375 3.375 0 1 0-4.773-4.773 3.375 3.375 0 0 0 4.774 4.774ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                    </svg>


                                    Ver
                                    Detalhes</a>
                            </div>
                            <dialog data-id='<%=client.id%>' class="jobDialog  text-main-text/85  flex-col ">
                                <form method="POST" action="/client/<%=client.id%>/addJob"
                                    class="actionForm m-4 flex flex-col gap-2 shrink-0 md:w-sm md:min-w-0 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg md:text-sm shadow-sm">
                                    <div class="inline-flex items-center justify-between">
                                        <p class="font-trispace text-2xl md:text-base text-job-accent  ">Adicionar
                                            Serviço: </br>
                                            <span class="text-main-accent text-wrap md:text-xl ">
                                                <%=client.name%>
                                            </span>
                                        </p>
                                        <button data-id='<%=client.id%>' type="button" class="closeDialog">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                stroke-width="2" stroke="currentColor"
                                                class="ml-4 size-6 hover:opacity-100 opacity-80">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M6 18 18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                    <p class="text-job-accent">Campos obrigatórios*</p>
                                    <p>Descrição<i class="text-job-accent">*</i></p>
                                    <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="descr"
                                         required />
                                    <p>Data <i class="text-job-accent">*</i></p>
                                    <input type="date" class="mx-2 rounded-2xl bg-input-box p-3" name="date" required />
                                    <p>Valor Total</p>
                                    <input type="text" class="valueInput mx-2 rounded-2xl bg-input-box p-3"
                                        name="totalValue" placeholder="123,45" />



                                    <button
                                        class="submitForm my-2 w-full cursor-pointer rounded-2xl bg-job-accent py-4 font-lato text-xl md:text-base font-bold text-gray-900 transition-all hover:opacity-80"
                                        type="submit">Criar Novo Serviço</button>
                                    <p class="actionError text-red-400"></p>
                                </form>
                            </dialog>
                            <% })%>
                                <% if(clients.length>=5 ) { %>
                                    <a href="/clients?page=0"
                                        class="my-1 rounded-2xl bg-client-accent items-center gap-2 justify-center text-center hover:opacity-80 text-gray-900 font-bold font-lato transition-all inline-flex px-4 py-4 text-xl ">
                                        Lista de Clientes <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                            viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                        </svg>
                                    </a>

                                    <% }; %>
                                        <% if(clients.length==0 ) { %>
                                            <div
                                                class="w-full rounded-2xl border-5 border-card-background bg-linear-to-tl from-card-background to-transparent px-3 py-4 text-center font-lato  shadow-sm">
                                                <p class="text-2xl md:text-xl font-bold text-client-accent">Aqui está
                                                    tão vazio...
                                                </p>
                                                <p>Tente criar o seu primeiro cliente!</p>



                                            </div>
                                            <% }; %>

                    </div>

                </div>
                <div class="max-sm:hidden w-1/5">

                </div>
            </div>
        </div>
        <footer class="w-full   gap-6  flex flex-col bg-footer text-[#bdc8c0]/80  text-sm p-6 font-lato">
            <p>Freelas é um serviço independente criado para fins educativos e praticidade de usuários, para saber
                mais sobre o projeto acesse nossa <a
                    class="text-main-accent hover:opacity-85 underline underline-offset-2"
                    href="https://github.com/fbetarelli/FreelanceManager">página no Github.</a>
            </p>
            <p>Freelas™ 2026 Todos os Direitos Resevados.</p>
        </footer>
    </div>
</body>

</html>