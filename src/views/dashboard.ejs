<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Freelas</title>
</head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Momo+Signature&family=Trispace:wght@100..800&display=swap"
    rel="stylesheet">
<link rel="stylesheet" href="/styles/output.css" />
<script src="/js/dashboard.js" defer></script>

<body>
    <div class="flex min-h-screen flex-col">
        <div
            class="inset-0 min-h-screen w-full bg-main-background bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] text-main-text/85">
            <header
                class="w-full mb-3  bg-linear-to-t from-card-background to-footer text-shadow-lg/30 text-main-accent rounded-b-4xl text-4xl p-5 font-momo">
                Freelas</header>
            <div class="flex flex-col gap-2 px-4 pt-4 pb-6">
                <div class="mb-2 flex items-center justify-between">
                    <p class="font-trispace text-3xl">Olá <%=username%>!</p>
                    <a href="/logout" class="inline-flex text-red-400 hover:opacity-75">
                        <p class="font-medium ">Sair</p>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                        </svg>

                    </a>
                </div>

                <dialog id="clientDialog" class="  text-main-text/85  flex-col ">
                    <form method="POST" action="/addClient"
                        class="m-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
                        <div class="inline-flex items-center justify-between">
                            <p class="font-trispace text-2xl text-main-accent">Adicionar Cliente</p>
                            <button id="closeClient" type="button">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                                    stroke="currentColor" class="ml-4 size-6 hover:opacity-100 opacity-80">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                        <p class="text-client-accent">Campos obrigatórios*</p>
                        <p>Nome<i class="text-client-accent">*</i></p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="name" maxlength="50"
                            placeholder="Ex: João da Silva" required />
                        <p>Endereço</p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="address" maxlength="60"
                            placeholder="Ex: Rua 9 de Julho, 412" />
                        <p>Contato <i class="text-client-accent">*</i></p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="contact" maxlength="30"
                            placeholder="Ex: (13) 97386-0157" required />

                        <button
                            class="my-2 w-full cursor-pointer rounded-2xl bg-client-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                            type="submit">Criar Novo Cliente</button>
                    </form>
                </dialog>



                <div
                    class="w-full rounded-2xl border-5 border-card-background bg-linear-to-tl from-card-background to-transparent px-3 py-4 text-center font-lato text-xl font-bold shadow-sm">
                    <p>Balanço:</p>
                    <p class="text-4xl text-main-accent">R$<%=profit%>
                    </p>
                    <p class="text-base text-[#bdc8c0]">(último mês)</p>
                </div>
                <div
                    class="w-full rounded-2xl border-5 border-card-background bg-linear-to-br from-card-background to-transparent px-3 py-4 text-center font-lato text-xl font-bold shadow-sm">
                    <p>Serviços:</p>
                    <p class="text-4xl text-main-accent">
                        <%=count%>
                    </p>
                    <p class="text-base text-[#bdc8c0]">(último mês)</p>
                </div>
                <div class="flex flex-row gap-2">
                    <button id="ClientBtn"
                        class=" inline-flex w-full justify-center text-center cursor-pointer items-center rounded-2xl bg-client-accent p-4 font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">


                        <p class="text-xl relative flex">Adicionar Cliente
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor"
                                class=" absolute right-full top-1/2 translate-y-[-50%] mr-4 size-8">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                            </svg>
                        </p>
                    </button>

                </div>
            </div>

            <div>
                <div class="flex flex-col gap-2">
                    <% if(jobs.length>0 ) { %>

                        <p class="px-6 font-trispace pb-2 text-xl text-job-accent">Últimos Serviços</p>

                        <div class="flex flex-row overflow-x-auto px-4  pb-4 font-lato font-bold">
                            <% jobs.forEach(job=> { %>
                                <div
                                    class="mx-2 flex w-full max-w-3xs shrink-0 flex-col justify-center gap-1 rounded-2xl bg-linear-to-b from-card-background to-card-background/50 p-4 shadow-sm">
                                    <p class="truncate font-lato text-lg font-bold">
                                        <%=job.descr%> <span class="text-gray-400 text-base">
                                                (<%=job.jobDate%>)
                                            </span>
                                    </p>
                                    <p class="text-base text-[#bdc8c0]">R$<%=job.totalValue%>
                                    </p>
                                    <p class="text-sm text-gray-400">
                                        <%=job.payed%>
                                    </p>
                                    <a href="/job/<%=job.id%>"
                                        class="my-1 rounded-2xl border-3 border-job-accent hover:bg-job-accent hover:text-gray-900 transition-all px-4 py-2 text-lg text-job-accent">Ver
                                        Serviço</a>
                                </div>
                                <% }) %>
                        </div>
                        <% }; %>


                </div>
            </div>

            <div id="clientList" class=" flex w-full flex-col gap-4 px-6 py-4 pb-8 ">
                <p class="font-trispace text-xl text-client-accent">Clientes</p>

                <% clients.forEach(client=> { %>
                    <div
                        class="flex w-full flex-col rounded-2xl border-5 border-card-background bg-linear-to-tl from-card-background to-transparent p-4 text-base shadow-sm">
                        <p class="text truncate font-lato font-bold">
                            <%= client.name %>
                        </p>
                        <p class="text-base text-client-accent">
                            <%= client.contact%>
                        </p>

                        <button data-id="<%=client.id%>"
                            class="openJobDialog inline-flex items-center  my-2 rounded-2xl border-3 border-job-accent hover:bg-job-accent transition-all hover:text-gray-900 px-4 py-2 font-lato font-bold text-job-accent">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="mr-2 size-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
                            </svg>

                            Novo Serviço
                        </button>

                        <a href="/client/<%=client.id%>"
                            class="h-sm my-2 rounded-2xl inline-flex items-center border-3 border-client-accent hover:bg-client-accent transition-all hover:text-gray-900 px-4 py-2 font-lato font-bold text-client-accent">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="m15.75 15.75-2.489-2.489m0 0a3.375 3.375 0 1 0-4.773-4.773 3.375 3.375 0 0 0 4.774 4.774ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>


                            Ver
                            Detalhes</a>
                    </div>
                    <dialog data-id='<%=client.id%>' class="jobDialog  text-main-text/85  flex-col ">
                        <form method="POST" action="/client/<%=client.id%>/addJob"
                            class="actionForm m-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
                            <div class="inline-flex items-center justify-between">
                                <p class="font-trispace text-2xl text-main-accent">Adicionar Serviço - <%=client.name%>
                                </p>
                                <button data-id='<%=client.id%>' type="button" class="closeDialog">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="2" stroke="currentColor"
                                        class="ml-4 size-6 hover:opacity-100 opacity-80">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                            <p class="text-job-accent">Campos obrigatórios*</p>
                            <p>Descrição<i class="text-job-accent">*</i></p>
                            <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="descr"
                                placeholder="Ex: Manutenção Preventiva" required />
                            <p>Data <i class="text-job-accent">*</i></p>
                            <input type="date" class="mx-2 rounded-2xl bg-input-box p-3" name="date" required />
                            <p>Valor Total</p>
                            <input type="text" class="valueInput mx-2 rounded-2xl bg-input-box p-3" name="totalValue"
                                placeholder="150,00" />



                            <button
                                class="submitForm my-2 w-full cursor-pointer rounded-2xl bg-job-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                                type="submit">Criar Novo Serviço</button>
                            <p class="actionError text-red-400"></p>
                        </form>
                    </dialog>
                    <% })%>
                        <% if(clients.length>=5 ) { %>
                            <a href="/clients?page=0"
                                class="my-1 rounded-2xl bg-client-accent text-center hover:opacity-80 text-gray-900 font-bold font-lato transition-all px-4 py-4 text-xl ">Ver
                                todos os clientes</a>

                            <% }; %>

            </div>

        </div>
        <footer class="w-full   gap-6  flex flex-col bg-footer text-[#bdc8c0]/80  text-sm p-6 font-lato">
            <p>Freelas é um serviço independente criado para fins educativos e praticidade de usuários, para saber
                mais sobre o projeto acesse nossa <a
                    class="text-main-accent hover:opacity-85 underline underline-offset-2"
                    href="https://github.com/fbetarelli/FreelanceManager">página no Github.</a>
            </p>
            <p>Freelas™ 2026 Todos os Direitos Resevados.</p>
        </footer>
    </div>
</body>

</html>