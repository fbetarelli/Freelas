<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="/js/dashboard.js" defer></script>
</head>

<body>
    <h1>dashboards</h1> </br>
    <h3>Olá! <%=username%>
    </h3>
    <a href="/logout">Sair</a>
    <h1>Balanço no último mês: <%=profit%>
    </h1>
    <h1>Últimos serviços:</h1>

    <% if(jobs.length>0 ) { %>
        <% jobs.forEach(job=> { %>
            <p>
                <b>Descrição:</b>
                <%=job.descr%>
                    <b>Data Realizada:</b>
                    <%=job.jobDate%>
                        <b> Valor Total:</b>
                        <%=job.totalValue%> </br>
                            <b> Status:</b>
                            <%=job.payed%> </br>
                                <a href='/job/<%=job.id%>'>Ver Serviço</a>
            </p>

            </br>
            <% })}; %>
                <h1>Lista de Clientes:</h1>
                <% clients.forEach(client=> {

                    %>
                    <div class="">
                        <h3>
                            Nome: <%= client.name %>
                        </h3>
                        <p>
                            Contato: <%= client.contact%>
                        </p>
                        <p>
                            Endereço: <%= client.address %>
                        </p>
                        <a href="/client/<%= client.id %>">Ver informações e serviços</a> </br>
                    </div>
                    <% })%>


                        <h3>Adicionar Cliente</h3>
                        <form method="POST" action="/addClient">
                            *Obrigatório </br>
                            * Nome: </br>
                            <input type="text" name="name" placeholder="insira o nome do cliente" required /> </br>
                            Endereço (opcional): </br>
                            <input type="text" name="address" placeholder="insira o endereço do cliente" /> </br>
                            * Contato: </br>
                            <input type="text" name="contact" placeholder="insira o contato do cliente" required />
                            </br>
                            <button type="submit">
                                Enviar
                            </button>
                        </form>
</body>

</html>