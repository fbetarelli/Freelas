<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>
        <%= client.name%>
            <%= client.id%>
    </h1>
    <form method="POST" action="/client/<%=client.id%>/edit">
        Nome: </br>
        <input type="text" name="name" placeholder="editar o nome do cliente" /> </br>
        Endereço: </br>
        <input type="text" name="address" placeholder="editar o endereço do cliente" /> </br>
        Contato: </br>
        <input type="text" name="contact" placeholder="editar o contato do cliente" /> </br>
        <button type="submit">
            Enviar
        </button>
    </form>
    <a href="/client/<%=client.id%>/delete">
        <h3>Apagar cliente</h3>
    </a>
    <h3>Criar Serviço</h3>
    <form method="POST" action="/client/<%=client.id%>/addService">
        Descrição: </br>
        <input type="text" name="descr" placeholder="Descrição do serviço" required /> </br>
        Data: </br>
        <input type="date" name="date" required /> </br>
        Valor Total: </br>
        <input type="text" name="totalValue" placeholder="Valor total do serviço" /> </br>
        <button type="submit">
            Enviar
        </button>
    </form>
    <h3>serviços</h3>
    <% if(jobs.length>0 ) { %>
        <% jobs.forEach(job=> { %>
            <p>
                <%=job.getDescription()%>
            </p>
            <% })}; %>

</body>

</html>