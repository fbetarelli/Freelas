<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>Freelas: <%=client.name%>

    </title>
</head>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
    href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Momo+Signature&family=Trispace:wght@100..800&display=swap"
    rel="stylesheet" />
<link rel="stylesheet" href="/styles/output.css" />
<script src="/js/clientPage.js" defer></script>
<script src="/js/mobileNav.js" defer></script>

<body>
    <div class="flex min-h-screen flex-col">
        <div
            class="inset-0 min-h-screen w-full bg-main-background bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] text-main-text/85">
             <header id="header"
                class="w-full z-10 mb-3 md:static transition-all  
                duration-300 ease-in-out sticky top-0 translate-y-0 md:translate-y-0 flex justify-between bg-linear-to-t from-card-background to-footer text-shadow-lg/30 text-main-accent rounded-b-4xl text-4xl p-5 font-momo">
                <a href="/">Freelas</a>
                <button class="md:hidden mr-2
                " id="hamburgerMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                        stroke="currentColor" class="size-8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            </header>

            <div id="menubackground"
                class="z-10 hidden  bg-[rgba(17,24,39,0.9)] left-0 top-0 w-full min-h-screen inset-0">
            </div>
            <div id="menu"
                class="fixed z-20 text-xl font-lato transition-all  
                duration-500  ease-in-out w-[70%] left-full top-0  min-h-screen bg-linear-to-t from-card-background from-60% to-footer">
                <div class="my-4">
                    <p class="text-4xl text-main-accent p-6  font-trispace">
                        Menu</p>

                    <div class="flex flex-col gap-8   text-lg">
                        <div class="w-full p-[1px]   bg-linear-to-r from-transparent via-[#243e5c] to-transparent">
                        </div>
                        <a href="/dashboard" class="
                         px-4  w-full inline-flex items-center     ">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                            Dashboard
                        </a>

                        <a href="/clients" class="
                         px-4  w-full inline-flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                            </svg>
                            Lista de Clientes</a>

                        <a href="/jobs" class="
                        px-4  w-full inline-flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                stroke="currentColor" class="size-6 mr-6">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
                            </svg>

                            Lista de Serviços</a>
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-2 px-4 pt-4 pb-6">
                <div class="pb-3">
                    <p class="font-trispace text-3xl font-medium text-client-accent">Página do Cliente</p>
                    <ul class="flex gap-1 truncate p-1 text-sm text-gray-500">
                        <li><a href="/dashboard" class="hover:underline">Dashboard</a> -></li>

                        <li><a href="/clients?page=0" class="hover:underline">Clientes</a> -></li>

                        <li>
                            <%=client.name%>
                        </li>
                    </ul>
                </div>

                <dialog id="clientDialog" class="flex-col text-main-text/85">
                    <form method="POST" action="/client/<%=client.id%>/edit"
                        class="m-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
                        <div class="inline-flex items-center justify-between">
                            <p class="font-trispace text-2xl text-main-accent">Editar Cliente</p>
                            <button id="closeClient" type="button">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                                    stroke="currentColor" class="ml-4 size-6 opacity-80 hover:opacity-100">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                        <p>Nome</p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="name"
                            value="<%=client.name%>" maxlength="50" />
                        <p>Endereço</p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="address"
                            value="<%=client.address%>" placeholder="Ex: Rua 9 de Julho, 412" maxlength="60" />
                        <p>Contato</p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="contact"
                            value="<%=client.contact%>" placeholder="Ex: (13) 97386-0157" maxlength="30" />

                        <button
                            class="my-2 w-full cursor-pointer rounded-2xl bg-client-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                            type="submit">Salvar Alterações</button>
                    </form>
                </dialog>

                <dialog id="jobDialog" class="flex-col text-main-text/85">
                    <form method="POST" action="/client/<%=client.id%>/addJob"
                        class="actionForm m-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
                        <div class="inline-flex items-center justify-between">
                            <p class="font-trispace text-2xl text-main-accent">Adicionar Serviço</p>
                            <button id="closeJob" type="button">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                                    stroke="currentColor" class="ml-4 size-6 opacity-80 hover:opacity-100">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                        <p class="text-job-accent">Campos obrigatórios*</p>
                        <p>Descrição<i class="text-job-accent">*</i></p>
                        <input type="text" class="mx-2 rounded-2xl bg-input-box p-3" name="descr"
                            placeholder="Ex: Manutenção Preventiva" required />
                        <p>Data <i class="text-job-accent">*</i></p>
                        <input type="date" class="mx-2 rounded-2xl bg-input-box p-3" name="date" required />
                        <p>Valor Total<i class="text-job-accent">*</i></p>
                        <input type="text" class="valueInput mx-2 rounded-2xl bg-input-box p-3" name="totalValue"
                            placeholder="150,00" required />

                        <button
                            class="submitForm my-2 w-full cursor-pointer rounded-2xl bg-job-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                            type="submit">Criar Novo Serviço</button>
                        <p class="actionError text-red-400"></p>
                    </form>
                </dialog>


                <div
                    class="w-full rounded-2xl border-5 border-card-background bg-linear-to-br from-card-background to-transparent px-4 py-4 font-lato text-lg font-bold shadow-sm">
                    <p class="font-trispace text-center   text-2xl">
                        <%=client.name%>
                    </p>
                    <div class="w-full p-[1px] my-3  bg-linear-to-r from-transparent via-[#243e5c] to-transparent">
                    </div>
                    <p class="wrap-anywhere">
                        <i class="text-client-accent ">Endereço: </i>
                        <%=client.address%>
                    </p>
                    <p><i class="text-client-accent">Contato: </i>
                        <%=client.contact%>
                    </p>
                </div>
                <div class="flex flex-row gap-2">
                    <button id="ClientBtn"
                        class="mx-auto inline-flex w-1/2 cursor-pointer items-center rounded-2xl bg-client-accent p-4 font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="mr-2 size-8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg>


                        <p>Editar Cliente</p>
                    </button>
                    <button id="newJobBtn"
                        class="mx-auto inline-flex w-1/2 cursor-pointer items-center rounded-2xl bg-job-accent p-4 font-lato text-base font-bold text-gray-900 transition-all hover:opacity-80">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="mr-2 size-8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
                        </svg>

                        Novo Serviço
                    </button>
                </div>
            </div>

            <div class="flex w-full flex-col gap-4 px-6 py-4 pb-8">
                <p class="font-trispace text-xl text-job-accent">Serviços</p>
                <% if(jobs.length>0 ) { %>
                    <% jobs.forEach(job=> { %>
                        <div
                            class="flex w-full flex-col rounded-2xl bg-linear-to-b from-card-background to-card-background/50 p-4 text-base shadow-sm">
                            <p class="truncate font-lato text-lg font-bold">
                                <%=job.descr%> <span class="text-gray-400 text-base">
                                        (<%=job.jobDate%>)
                                    </span>
                            </p>
                            <p class="text-job-accent truncate font-lato font-bold">
                                R$<%=job.totalValue%>
                            </p>

                            <p class="text-gray-400">
                                <%=job.payed%>
                            </p>
                            <a href="/job/<%=job.id%>"
                                class="h-sm my-2 rounded-2xl border-3 border-job-accent px-4 py-2 font-lato font-bold text-job-accent transition-all hover:bg-job-accent hover:text-gray-900">Ver
                                Detalhes</a>
                        </div>
                        <% })} %>
            </div>
        </div>
        <footer class="flex w-full flex-col gap-6 bg-footer p-6 font-lato text-sm text-[#bdc8c0]/80">
            <p>Freelas é um serviço independente criado para fins educativos e praticidade de usuários, para saber mais
                sobre o projeto acesse nossa <a class="text-main-accent underline underline-offset-2 hover:opacity-85"
                    href="https://github.com/fbetarelli/FreelanceManager">página no Github.</a></p>
            <p>Freelas™ 2026 Todos os Direitos Resevados.</p>
        </footer>
    </div>
</body>

</html>