<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Freelas: Login</title>
</head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Momo+Signature&family=Trispace:wght@100..800&display=swap"
    rel="stylesheet">
<link rel="stylesheet" href="/styles/output.css" />

<body>
    <div class="flex min-h-screen flex-col">
        <div
            class="inset-0 min-h-screen w-full   bg-main-background bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] text-main-text/85">
            <header
                class="w-full mb-3  bg-linear-to-t from-card-background to-footer text-shadow-lg/30 text-main-accent rounded-b-4xl text-4xl p-5 font-momo">
                Freelas</header>

            <p class="p-3 font-trispace text-3xl text-main-accent">Login</p>
            <div class="flex-col text-main-text/85">
                <form method="POST" action="/login"
                    class="mx-4 flex flex-col gap-2 rounded-2xl bg-card-background px-7 py-4 font-lato text-lg shadow-sm">
                    <div class="inline-flex items-center justify-between">
                        <p class="font-trispace text-2xl">Bem vindo de volta!</p>
                    </div>
                    <p class="text-[#bdc8c0]">Não tem uma conta ainda? </br><a
                            class="text-main-accent hover:opacity-85 underline underline-offset-2"
                            href="/register">Registre-se aqui!</a></p>
                    <p>Email </p>
                    <input type="email" class="mx-2 rounded-2xl bg-input-box p-3" name="email" required
                        placeholder="email@exemplo.com" />
                    <p>Senha</p>
                    <input type="password" class="mx-2 rounded-2xl bg-input-box p-3" name="password"
                        placeholder="Insira sua senha aqui" required />


                    <button
                        class="my-2 w-full cursor-pointer rounded-2xl bg-main-accent py-4 font-lato text-xl font-bold text-gray-900 transition-all hover:opacity-80"
                        type="submit">Fazer Login</button>
                    <% if (message.length>0) { %>
                        <p class=" text-red-400">
                            <%=message[0]%>
                        </p>
                        <% }%>
                </form>
            </div>

        </div>
        <footer class="w-full  gap-6  flex flex-col bg-footer text-[#bdc8c0]/80  text-sm p-6 font-lato">
            <p>Freelas é um serviço independente criado para fins educativos e praticidade de usuários, para saber
                mais sobre o projeto acesse nossa <a
                    class="text-main-accent hover:opacity-85 underline underline-offset-2"
                    href="https://github.com/fbetarelli/FreelanceManager">página no Github.</a>
            </p>
            <p>Freelas™ 2026 Todos os Direitos Resevados.</p>
        </footer>
    </div>

</body>

</html>